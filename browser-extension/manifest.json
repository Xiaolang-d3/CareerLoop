{
  "manifest_version": 3,
  "name": "BossCopilot Browser",
  "version": "0.1.0",
  "description": "将用户主动选择的浏览器页面交给本机 BossCopilot 智能体处理。",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:5173/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*.zhipin.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BossCopilot Browser",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:5173/*",
        "http://localhost:5173/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.zhipin.com/*"
      ],
      "js": [
        "boss-extractor.js",
        "visible-jobs-extractor.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
