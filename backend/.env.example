MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.5
MODEL_MAX_TOOL_ROUNDS=8
MODEL_TIMEOUT_SECONDS=60
# 当前模型轮次内，只有明确标记为可重试的临时错误才会使用此预算。
MODEL_RETRY_ATTEMPTS=1
# 单个工具调用超时；与模型调用超时分开控制。
TOOL_EXECUTION_TIMEOUT_SECONDS=60
# 仅只读、派生分析和外部读取工具可自动重试；本地写工具永不自动重放。
TOOL_RETRY_ATTEMPTS=1

# 默认只监听本机。需要手机或其它电脑访问时改为 0.0.0.0，
# 并把本机局域网 IP 或主机名写入 PUBLIC_HOSTS（逗号分隔）。
# 开放前请确认：强密码、仅在受信任网络、了解明文 HTTP 风险。
# BIND_HOST=0.0.0.0
# PUBLIC_HOSTS=192.168.1.3
# 需要额外的自定义前端来源时（含协议和端口）再补充。
# ALLOWED_ORIGINS=https://careerloop.example.com

# /docs 与 /openapi.json 会暴露全部接口结构；非本机监听时默认关闭。
# API_DOCS_ENABLED=false

# 登录失败次数限制，防止局域网内被爆破。
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=300

# 首次打开系统时在登录页创建本地管理员账户。密码只保存为安全哈希。
# 登录会话默认有效 8 小时；可按需调整。
# AUTH_TOKEN_TTL_SECONDS=28800

# 使用 OpenAI 或兼容网关时配置，禁止提交真实密钥。
# OPENAI_API_KEY=
# MODEL_BASE_URL=

# 多用户托管：必须使用稳定且保密的 Fernet 主密钥，并单独备份。
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CAREERLOOP_DEPLOYMENT_MODE=hosted
# CAREERLOOP_SECRET_MASTER_KEY=
# 除 OpenAI、Anthropic、Gemini 官方域名外，额外允许的 HTTPS 模型服务域名（逗号分隔）。
# CAREERLOOP_MODEL_ALLOWED_HOSTS=api.example.com

# Desktop package sets these internally. Do not set them for the browser build.
# CAREERLOOP_DATA_DIR=
# CAREERLOOP_DESKTOP=false

# 附件默认保存在本地 data/attachments。启用 MinIO 后，桶保持私有。
# ATTACHMENT_STORAGE=minio
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_ACCESS_KEY=careerloop
# MINIO_SECRET_KEY=change-this-before-sharing
# MINIO_BUCKET=careerloop-attachments
# MINIO_SECURE=false
# 可选：用于其他对象存储临时签名 URL；模型看图不需要公网地址。
# MINIO_PUBLIC_ENDPOINT=https://files.example.com
# 默认关闭。开启后，用户可在单轮聊天中明确授权图片随模型请求发送；支持本地附件，无需 MinIO。
# ATTACHMENT_VISION_ENABLED=false
# ATTACHMENT_VISION_URL_TTL_SECONDS=300

# 本地知识检索默认用 FastEmbed 中文 BGE；测试会强制 hash。
# 更换模型或维度后，下次检索会按 knowledge_chunks 原文重建向量表。
# EMBEDDING_BACKEND=auto
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_CACHE_DIR=
# EMBEDDING_DIMENSIONS=

# 联网搜索默认关闭；配置后显式启用，并重启后端。
# WEB_RESEARCH_ENABLED=true
# auto：有 Tavily Key 就使用 Tavily，否则使用 AgentSearch。
# 也可显式指定 tavily 或 agent_search；鉴权或额度错误不会自动换服务。
# WEB_SEARCH_PROVIDER=auto
# Tavily 直接调用官方 API，无需启动本地 AgentSearch。
# TAVILY_API_KEY=
# AGENT_SEARCH_BASE_URL=http://127.0.0.1:3939
# 如 AgentSearch 开启了本地 bearer auth，在此配置同一令牌。
# AGENT_SEARCH_TOKEN=
# WEB_RESEARCH_TIMEOUT_SECONDS=25
# WEB_RESEARCH_MAX_SOURCES=10

# 首页官方模型评测 Data API；在 Artificial Analysis 平台申请免费 Key。
# 仅由后端调用，勿使用 VITE_ 前缀或提交真实密钥。配置后重启后端。
# 文档：https://artificialanalysis.ai/data-api/docs/reference
# ARTIFICIAL_ANALYSIS_API_KEY=

# 项目工作室从公开 GitHub 仓库拉目录树时可选。未配置时走匿名限额。
