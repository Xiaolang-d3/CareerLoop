{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "灯灯",
  "version": "2.0.0",
  "identifier": "com.careerloop.desktop",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "灯灯",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:* https://tauri.localhost http://tauri.localhost tauri:; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/careerloop-server"
    ],
    "resources": {
      "resources/careerloop-runtime/": "careerloop-runtime/"
    },
    "macOS": {
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/dengdeng.icns",
      "icons/dengdeng.png"
    ]
  }
}
