[
  {
    "description": "未出现在证据里的经历不得写成事实",
    "vars": {
      "task": "invent",
      "content": "我曾负责千万级交易系统的清算链路，并把它稳定在 99.99%。",
      "evidence": "使用 Python 和 FastAPI 构建本地求职 Agent，负责检索与评估模块。",
      "expected": {
        "valid": false
      }
    }
  },
  {
    "description": "只复述证据中的经历可以通过",
    "vars": {
      "task": "invent",
      "content": "我曾负责检索与评估模块，用 FastAPI 做本地求职 Agent。",
      "evidence": "使用 Python 和 FastAPI 构建本地求职 Agent，负责检索与评估模块。",
      "expected": {
        "valid": true
      }
    }
  },
  {
    "description": "正文里二选一提问却不调用 ask_user 算违规",
    "vars": {
      "task": "ask_user",
      "content": "你指的是腾讯还是阿里？",
      "tool_calls": "",
      "expected": {
        "used_ask_user": false,
        "should_ask_user": true,
        "violation": true
      }
    }
  },
  {
    "description": "调用 ask_user 后不应再判正文提问违规",
    "vars": {
      "task": "ask_user",
      "content": "",
      "tool_calls": "ask_user",
      "expected": {
        "used_ask_user": true,
        "should_ask_user": false,
        "violation": false
      }
    }
  },
  {
    "description": "分类器可识别通用资料问答",
    "vars": {
      "task": "classify",
      "query": "帮我回答刚才的问题",
      "model_output": "{\"kind\":\"library_search\"}",
      "expected": {
        "keyword_kind": "conversation",
        "kind": "library_search",
        "allowed_tools": [
          "get_library_context",
          "search_library"
        ]
      }
    }
  },
  {
    "description": "分类器不能点名工具",
    "vars": {
      "task": "classify",
      "query": "帮我回答刚才的问题",
      "model_output": "{\"kind\":\"search_library\"}",
      "expected": {
        "kind": "conversation",
        "empty_tools": true
      }
    }
  },
  {
    "description": "分类器不能恢复旧路由",
    "vars": {
      "task": "classify",
      "query": "这家靠谱吗",
      "model_output": "{\"kind\":\"company_research\"}",
      "expected": {
        "kind": "conversation",
        "empty_tools": true
      }
    }
  },
  {
    "description": "分类器不能改写已经命中的资料车道",
    "vars": {
      "task": "classify",
      "query": "根据我的知识库回答问题",
      "model_output": "{\"kind\":\"web_search\"}",
      "expected": {
        "keyword_kind": "library_search",
        "kind": "library_search",
        "allowed_tools": [
          "get_library_context",
          "search_library"
        ]
      }
    }
  },
  {
    "description": "规划器不得给本地问答添加联网",
    "vars": {
      "task": "plan",
      "query": "根据我的资料回答问题",
      "kind": "library_search",
      "model_output": "{\"steps\":[{\"tool_name\":\"get_library_context\"},{\"tool_name\":\"search_public_web\"}]}",
      "expected": {
        "parsed_tools": [
          "get_library_context"
        ],
        "dropped_tools": [
          "search_public_web"
        ]
      }
    }
  },
  {
    "description": "规划器不得把公开查询扩成知识写入",
    "vars": {
      "task": "plan",
      "query": "联网查询天文资料",
      "kind": "web_search",
      "model_output": "{\"steps\":[{\"tool_name\":\"search_public_web\"},{\"tool_name\":\"propose_library_knowledge\"}]}",
      "expected": {
        "parsed_tools": [
          "search_public_web"
        ],
        "dropped_tools": [
          "propose_library_knowledge"
        ]
      }
    }
  },
  {
    "description": "未知工具回退仍受完成义务限制",
    "vars": {
      "task": "plan",
      "query": "记录知识",
      "kind": "library_update",
      "model_output": "{\"steps\":[{\"tool_name\":\"invented_writer\"}]}",
      "expected": {
        "parsed_tools": [
          "propose_library_knowledge"
        ],
        "dropped_tools": [
          "invented_writer"
        ]
      }
    }
  },
  {
    "description": "ask_user 不进入资料计划",
    "vars": {
      "task": "plan",
      "query": "根据知识库写文章",
      "kind": "content_creation",
      "model_output": "{\"steps\":[{\"tool_name\":\"ask_user\"},{\"tool_name\":\"get_library_context\"}]}",
      "expected": {
        "parsed_tools": [
          "get_library_context"
        ],
        "dropped_tools": [
          "ask_user"
        ]
      }
    }
  }
]
