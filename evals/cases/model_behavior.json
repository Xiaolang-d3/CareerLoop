      "task": "classify",
      "query": "这家靠谱吗",
      "model_output": "{\"kind\":\"research_company\"}",
      "expected": {
        "keyword_kind": "conversation",
        "kind": "conversation",
        "empty_tools": true
      }
    }
  },
  {
    "description": "分类器不能改写已经命中的 JD 车道",
