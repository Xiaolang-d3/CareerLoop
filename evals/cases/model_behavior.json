[
  {
    "description": "分类器可把模糊靠谱问句升到公司研究",
    "vars": {
      "task": "classify",
      "query": "这家靠谱吗",
      "model_output": "{\"kind\":\"company_research\"}",
      "expected": {
        "keyword_kind": "conversation",
        "kind": "company_research",
        "contains_tools": ["research_company"],
        "forbidden_tools": ["search_public_web", "ask_user"]
      }
    }
  },
  {
    "description": "分类器输出工具名必须忽略",
