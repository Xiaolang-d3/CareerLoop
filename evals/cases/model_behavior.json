      "model_output": "{\"kind\":\"web_search\"}",
      "expected": {
        "keyword_kind": "jd_analysis",
        "kind": "jd_analysis",
        "contains_tools": ["analyze_resume_against_jd"],
        "forbidden_tools": ["search_public_web"]
      }
    }
  },
  {
    "description": "分类器输出已删除车道时保持普通对话",
    "vars": {
      "task": "classify",
      "query": "帮我在 BOSS 搜索几个岗位",
      "model_output": "{\"kind\":\"opportunity_discovery\"}",
      "expected": {
        "keyword_kind": "conversation",
        "kind": "conversation",
        "empty_tools": true,
        "forbidden_tools": ["search_public_web"]
      }
    }
  },
  {
    "description": "规划器点名联网工具时必须丢弃",
    "vars": {
      "task": "plan",
      "query": "分析这个岗位是否适合我",
      "kind": "jd_analysis",
      "model_output": "{\"goal\":\"分析岗位\",\"steps\":[{\"tool_name\":\"analyze_resume_against_jd\",\"title\":\"对比\"},{\"tool_name\":\"search_public_web\",\"title\":\"上网搜\"}]}",
      "expected": {
        "parsed_tools": ["analyze_resume_against_jd"],
        "dropped_tools": ["search_public_web"]
      }
    }
  },
  {
    "description": "规划器不得把公司研究扩成简历分析",
    "vars": {
      "task": "plan",
      "query": "帮我调查一下示例科技这家公司怎么样",
      "kind": "company_research",
      "model_output": "{\"goal\":\"调查公司\",\"steps\":[{\"tool_name\":\"research_company\",\"title\":\"搜公司\"},{\"tool_name\":\"analyze_resume_against_jd\",\"title\":\"对简历\"}]}",
      "expected": {
        "parsed_tools": ["research_company"],
        "dropped_tools": ["analyze_resume_against_jd"]
      }
    }
  },
  {
    "description": "规划器点名未知工具时走车道兜底且不含 ask_user",
    "vars": {
      "task": "plan",
      "query": "帮我调查一下示例科技这家公司怎么样",
      "kind": "company_research",
